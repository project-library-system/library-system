FROM node:20-alpine
WORKDIR /app

# 1. Copia package files
COPY package*.json ./

# 2. Instala TODAS dependências (inclui @nestjs/cli)
RUN npm ci

# 3. Copia código
COPY . .

RUN npx prisma generate  // ← gera o client dentro do container


EXPOSE 8080

# 5. DESENVOLVIMENTO: nest start --watch
CMD ["npm", "run", "start:dev"]
